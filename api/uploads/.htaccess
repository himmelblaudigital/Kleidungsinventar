# Hochgeladene Dateien dürfen niemals als PHP ausgeführt werden.
<FilesMatch "\.(php|phtml|php3|php4|php5|phar)$">
    Require all denied
</FilesMatch>

Options -Indexes

# php_flag funktioniert nur mit mod_php; ohne IfModule würde sonst jede Anfrage
# in diesem Ordner (also auch jedes Bild) mit HTTP 500 scheitern (PHP-FPM/CGI).
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
